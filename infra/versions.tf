terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Local state — solo portfolio account, same pattern as retail-lakehouse-aws.
}

provider "aws" {
  region = var.aws_region
}
